{
  "name": "discord-bot-exemple",
  "version": "1.0.0",
  "main": "dist/bot.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Starter template for a discord.js v14 bot in TypeScript: slash commands, components, tasks, Redis, Docker.",
  "dependencies": {
    "discord.js": "^14.28.1",
    "ioredis": "^5.10.0",
    "pg": "^8.23.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/bot.js",
    "dev": "tsx watch --env-file-if-exists=.env src/bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
