# Required. Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional. A server id: commands update there instantly. Empty: global (up to an hour).
GUILD_ID=
# Optional. Only if you call connectToDatabase() in src/bot.ts.
DATABASE_URL=
# Optional. Empty REDIS_HOST: the bot runs without Redis. Port defaults to 6379.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
